# ─── Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database (MongoDB Atlas Free M0) ─────────────────────
# Get this from Atlas → Connect → Drivers → Node.js
# Replace <username>, <password>, and <cluster> with your values
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/elder-care?retryWrites=true&w=majority&appName=Cluster0

# ─── Authentication ────────────────────────────────────────
# Use a long random string in production (e.g. openssl rand -hex 64)
JWT_SECRET=change_this_to_a_long_random_secret_in_production

# ─── CORS ──────────────────────────────────────────────────
# Local dev: http://localhost:3000
# After deploy: your S3/CloudFront URL e.g. https://d1234.cloudfront.net
FRONTEND_URL=http://localhost:3000

# ─── AWS (filled after Step 5 deploy) ─────────────────────
# Your API Gateway invoke URL e.g. https://abc123.execute-api.us-east-1.amazonaws.com/prod
API_GATEWAY_URL=

# ─── Google Maps (optional) ───────────────────────────────
GOOGLE_MAPS_KEY=

# ─── Twilio SMS Alerts (optional) ─────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=+1XXXXXXXXXX
EMERGENCY_CONTACT_1=+91XXXXXXXXXX
EMERGENCY_CONTACT_2=+91XXXXXXXXXX
EMERGENCY_CONTACT_3=
